{
  "id": "pack_talkativetortoise",
  "mode": "general",
  "sku": "sku_tortoise_001",
  "stories": [
    {
      "id": "story_tortoise_01",
      "mode": "general",
      "template": "narrative",
      "title": {
        "en": "The Talkative Tortoise"
      },
      "pages": [
        {
          "text": "Once, a friendly but very talkative tortoise lived in a big lake.",
          "imageAsset": "assets/packs/images/tortoise_01_lake.png",
          "copingCardId": null
        },
        {
          "text": "His best friends were two lovely white geese who flew in the sky.",
          "imageAsset": "assets/packs/images/tortoise_02_friends.png",
          "copingCardId": null
        },
        {
          "text": "One day, the lake began to dry up in the hot sun.",
          "imageAsset": "assets/packs/images/tortoise_03_dry_lake.png",
          "copingCardId": null
        },
        {
          "text": "The geese said, 'We will carry you to a new lake on a strong stick!'",
          "imageAsset": "assets/packs/images/tortoise_04_idea.png",
          "copingCardId": null
        },
        {
          "text": "'Hold on tight with your mouth, and do not speak!' they warned.",
          "imageAsset": "assets/packs/images/tortoise_05_warning.png",
          "copingCardId": null
        },
        {
          "text": "Up they flew, but soon the tortoise wanted to say hello to a bird.",
          "imageAsset": "assets/packs/images/tortoise_06_flying.png",
          "copingCardId": null
        },
        {
          "text": "He opened his mouth, let go of the stick, and down he fell!",
          "imageAsset": "assets/packs/images/tortoise_07_falling.png",
          "copingCardId": null
        },
        {
          "text": "Splash! He landed safely in a soft pond, feeling very silly.",
          "imageAsset": "assets/packs/images/tortoise_08_safe_splash.png",
          "copingCardId": null
        }
      ],
      "voiceKeywords": ["tortoise", "geese", "lake", "fly", "stick", "splash"],
      "castIds": ["kambu", "goose"],
      "lowArousal": false,
      "learningGoal": "Think before you speak, and listen to good advice."
    }
  ]
}
